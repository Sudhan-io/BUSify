# BUSify — Production Environment Variables
# ============================================================
# Copy this file to `.env` and fill in every value.
# NEVER commit your actual .env to version control.
# Add `.env` to .gitignore immediately.
# ============================================================

# ─── Database ────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite:///./busify.db

# Production (PostgreSQL — uncomment and fill):
# DATABASE_URL=postgresql+psycopg2://busify_user:STRONG_PASSWORD@db:5432/busify_prod

# ─── Security ────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_128_CHAR_HEX_SECRET_GENERATED_BY_PYTHON

# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
STUDENT_HASH_SALT=REPLACE_WITH_64_CHAR_HEX_SECRET_GENERATED_BY_PYTHON

# ─── Application Passwords ───────────────────────────────────
# REQUIRED for the /api/auth/token login endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
TRANSPORT_OFFICER_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# ─── OSRM Routing Engine ─────────────────────────────────────
# Self-hosted OSRM container (see docker-compose.yml).
# Inside docker-compose network use the service name 'osrm'.
# For local dev without Docker, temporarily set:
#   OSRM_BASE_URL=http://127.0.0.1:5000
OSRM_BASE_URL=http://osrm:5000

# Set to True ONLY during OSRM container warm-up or local dev without OSRM.
# NEVER set True in production — produces incorrect straight-line routes.
ENABLE_OFFLINE_HAVERSINE_FALLBACK=False

OSRM_REQUEST_TIMEOUT_SECONDS=5.0
OSRM_MAX_RETRIES=3

# ─── CORS ────────────────────────────────────────────────────
# Production: Replace with your actual frontend domain.
# Example: https://busify.vsb.edu.in
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Campus Configuration ────────────────────────────────────
# Only change if deploying for a different campus.
COLLEGE_DEPOT_LAT=10.95488
COLLEGE_DEPOT_LON=77.95462
COLLEGE_NAME=VSB Engineering College, Karudayampalayam, Karur

# ─── Fleet Defaults ──────────────────────────────────────────
TOTAL_FLEET_SIZE=50
DEFAULT_BUS_CAPACITY=55
FIRST_CLASS_ARRIVAL_TIME=08:30
